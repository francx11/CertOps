{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertOps Question Bank",
  "description": "Schema for a CertOps certification question bank",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "domain", "question", "options", "correct", "explanation", "source", "tags", "added"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[0-9a-f]{12}$"
      },
      "domain": {
        "type": "string",
        "minLength": 1
      },
      "question": {
        "type": "string",
        "minLength": 10
      },
      "options": {
        "type": "object",
        "minProperties": 2,
        "maxProperties": 6,
        "propertyNames": {
          "pattern": "^[A-F]$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "correct": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-F]$"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-F]$"
            },
            "minItems": 2,
            "uniqueItems": true
          }
        ]
      },
      "explanation": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "added": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
      }
    }
  },
  "uniqueItems": true
}
